# Database
POSTGRES_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/banking_system

# Optional Render-style URL (postgres://user:pass@host:5432/dbname)
# DATABASE_URL=

# Seed a bank staff user on first boot (optional if you use Sign Up)
BANK_STAFF_USERNAME=teller
BANK_STAFF_PASSWORD=change-me-now

# CORS origin in production if the UI is hosted separately. Leave unset when
# the Java server also serves the frontend (same origin).
# FRONTEND_URL=https://your-frontend.onrender.com

# Directory of static files (used in Docker)
# FRONTEND_DIR=/app/frontend

# Render sets this automatically
# PORT=8080
